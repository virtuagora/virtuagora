# Database Configuration
DB_HOST=mysql
DB_NAME=virtuagora
DB_USER=virtuagora_user
DB_PASSWORD=virtuagora_pass

# MySQL Root Password
MYSQL_ROOT_PASSWORD=root_password

# Twig Configuration
TWIG_CACHE=false
TWIG_AUTO_RELOAD=true

# Application Environment
APP_ENV=development

# Github Configuration
# This token is used by composer to access and download a public repository.
# Generate a new token at Github
GITHUB_TOKEN=#####